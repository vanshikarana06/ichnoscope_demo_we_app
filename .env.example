# Ichnoscope / Sentry Telemetry Configuration
# Paste your Project DSN from Ichnoscope (or Sentry):
# Example: https://pk_live_xxx@ichnoisapi.onrender.com/api/proj_xxx
ICHNOSCOPE_DSN=
SENTRY_DSN=

# Application Environment tag (production, development, staging)
ENVIRONMENT=production
SENTRY_ENVIRONMENT=production

# Performance Tracing Sample Rate (1.0 = 100%, 0.1 = 10% for high-traffic)
TRACES_SAMPLE_RATE=1.0

# Server HTTP Port
PORT=5000
