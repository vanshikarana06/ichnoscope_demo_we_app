# Sentry Python SDK Telemetry Configuration
# Paste your Project DSN from Sentry:
# Sentry -> Settings -> Projects -> [Project] -> Client Keys (DSN)
# Example: https://xxxxxxxxxxxxxxxxxxxx@o123456.ingest.us.sentry.io/7890123
SENTRY_DSN=

# Sentry Environment tag (production, staging, development)
SENTRY_ENVIRONMENT=production

# Server HTTP Port
PORT=5000
